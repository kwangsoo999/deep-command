POSTGRES_DB=deepcommand
POSTGRES_USER=deepcommand
# Set a strong password locally before running compose. Never commit .env.
POSTGRES_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Optional browser-to-API URL; bundled at build time. Never put secrets in VITE_* variables.
VITE_API_URL=http://localhost:8000
